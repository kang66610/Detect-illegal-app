# ===== App 隐私合规自动化检测平台 配置模板 =====
# 使用方法：复制本文件为 .env 后修改；.env 已 gitignore，不会入库。
# 删除 .env 则按代码默认值运行（与本模板默认值一致）。

# --- 存储路径（相对项目根） ---
PRIVACY_DB_PATH=data/app.db
PRIVACY_APK_DIR=data/apks
PRIVACY_EVIDENCE_DIR=data/evidence
# Worker 自动对账并清理不再属于任何任务的历史证据目录：先隔离，后按保留期永久清理。
PRIVACY_EVIDENCE_GC_ENABLED=true
PRIVACY_EVIDENCE_GC_GRACE_HOURS=72
PRIVACY_EVIDENCE_GC_TRASH_RETENTION_DAYS=7
PRIVACY_EVIDENCE_GC_MAX_DIRS_PER_RUN=500
PRIVACY_EVIDENCE_GC_INTERVAL_HOURS=6
PRIVACY_EXPORT_DIR=data/exports
PRIVACY_LOG_DIR=data/logs
PRIVACY_RETENTION_DAYS=90

# --- Worker（检测并发） ---
PRIVACY_WORKER_MAX_CONCURRENT=3
PRIVACY_WORKER_POLL_INTERVAL=2

# --- 检测档位限制 ---
PRIVACY_FAST_MAX_MINUTES=30
PRIVACY_FAST_MAX_PAGES=60
PRIVACY_DEEP_MAX_MINUTES=120
PRIVACY_DEEP_MAX_PAGES=300
# 权限探针：deny（默认，验证拒绝后业务是否受阻）/ allow（验证授权后的真实调用）/ observe（只采集）
PRIVACY_PERMISSION_PROBE_ACTION=deny
# 对拒绝权限后的后续页面最多观察多少步；不自动提交表单或修改用户数据。
PRIVACY_PERMISSION_PROBE_POST_STEPS=6
PRIVACY_MANUAL_LOGIN_WAIT_SECONDS=120
PRIVACY_TEST_ACCOUNT_ENABLED=false
PRIVACY_TEST_ACCOUNT_USERNAME_ENV=PRIVACY_TEST_ACCOUNT_USERNAME
PRIVACY_TEST_ACCOUNT_PASSWORD_ENV=PRIVACY_TEST_ACCOUNT_PASSWORD
# PRIVACY_TEST_ACCOUNT_USERNAME=dedicated-audit-account
# PRIVACY_TEST_ACCOUNT_PASSWORD=set-only-in-local-secret-environment
PRIVACY_SUBSEQUENT_PHASE_LOGIN_WAIT_SECONDS=5
# 同意隐私政策后多少秒内出现权限弹窗，作为“未进入业务功能即申请权限”的证据窗口。
PRIVACY_PERMISSION_AFTER_CONSENT_WINDOW_SECONDS=30
PRIVACY_PERMISSION_GRANT_VERIFY_ATTEMPTS=4
PRIVACY_PERMISSION_GRANT_VERIFY_INTERVAL_SECONDS=1

# --- 大模型（OpenAI 兼容协议：千问/DeepSeek/GLM 均可） ---
PRIVACY_LLM_PROVIDER=openai_compatible
PRIVACY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRIVACY_LLM_MODEL=qwen3.6-plus
PRIVACY_LLM_TIMEOUT_SECONDS=30
LLM_API_KEY=在此填写你的 API Key

# --- 真实 Android 遍历（Appium）---
PRIVACY_APPIUM_SERVER_URL=http://127.0.0.1:4725
PRIVACY_APPIUM_DEVICE_NAME=Android
PRIVACY_APPIUM_PLATFORM_VERSION=
PRIVACY_APPIUM_UDID=
# 每次检测均会先卸载同包名 App 后重新安装；此项保持 false，避免残留会话影响首次启动场景。
PRIVACY_APPIUM_NO_RESET=false
PRIVACY_APPIUM_COMMAND_TIMEOUT=600
PRIVACY_APPIUM_PAGE_WAIT_SECONDS=1
# 同意后白屏/仅 FrameLayout 时，先等待可点击控件再交给模型；避免模拟器加载慢被误判为“无可遍历路径”。
PRIVACY_PAGE_SETTLE_RETRIES=4
PRIVACY_PAGE_SETTLE_WAIT_SECONDS=3
PRIVACY_LOADING_SHELL_COLD_RESTART_LIMIT=1
PRIVACY_DOCUMENT_BOTTOM_CONFIRMATIONS=2
PRIVACY_DOCUMENT_STUCK_RETRIES=3
PRIVACY_DOCUMENT_STUCK_WAIT_SECONDS=2
PRIVACY_EXTERNAL_DOCUMENT_WAIT_RETRIES=2
PRIVACY_EXTERNAL_DOCUMENT_WAIT_SECONDS=1.5
PRIVACY_EXTERNAL_DOCUMENT_IDENTITY_WAIT_RETRIES=2
PRIVACY_EXTERNAL_DOCUMENT_IDENTITY_WAIT_SECONDS=1
# Android 15 AVD can use true to bypass Appium Settings initialization when
# the audit does not need emulator-side location injection or settings controls.
PRIVACY_APPIUM_SKIP_DEVICE_INITIALIZATION=false
PRIVACY_APPIUM_IGNORE_HIDDEN_API_POLICY_ERROR=true
PRIVACY_APPIUM_UIAUTOMATOR2_LAUNCH_TIMEOUT_SECONDS=90
PRIVACY_APPIUM_SESSION_RETRIES=2
PRIVACY_APPIUM_AUTO_RECOVER=true
# 确保模拟器已安装的系统 WebView 处于启用状态，避免条款页启动时缺少 libmonochrome。
PRIVACY_APPIUM_ENSURE_WEBVIEW_PROVIDER=true
# Only local emulator-* devices may use this last-resort no-wipe recovery.
# A 15-minute cooldown prevents repeated restarts during a task queue.
PRIVACY_APPIUM_AUTO_REBOOT_ON_UIAUTOMATOR2_FAILURE=false
PRIVACY_APPIUM_UIAUTOMATOR2_REBOOT_TIMEOUT_SECONDS=120
PRIVACY_APPIUM_UIAUTOMATOR2_REBOOT_COOLDOWN_SECONDS=900
PRIVACY_APPIUM_WAIT_FOR_ANDROID_SERVICES=true
PRIVACY_APPIUM_ANDROID_SERVICE_READY_CHECKS=2
# Windows 示例：C:/Users/<用户名>/AppData/Local/Android/Sdk/platform-tools/adb.exe
PRIVACY_APPIUM_ADB_PATH=
# When the local 127.0.0.1 Appium process is absent, let the Worker start the
# cached Appium CLI and wait for /status. Remote endpoints are never started
# automatically.
PRIVACY_APPIUM_AUTO_START=false
PRIVACY_APPIUM_STARTUP_TIMEOUT_SECONDS=20

# --- 动态 Hook（Frida）---
# spawn_target=true 会由 Frida 启动目标 App，便于捕获冷启动阶段的敏感调用。
PRIVACY_FRIDA_DEVICE_ID=
PRIVACY_FRIDA_SPAWN_TARGET=true
PRIVACY_FRIDA_AUTO_START=true
PRIVACY_FRIDA_SERVER_PATH=/data/local/tmp/frida-server
PRIVACY_FRIDA_STARTUP_TIMEOUT_SECONDS=12
PRIVACY_FRIDA_OPERATION_TIMEOUT_SECONDS=20
PRIVACY_FRIDA_MONITOR_SECONDS=0
# 可选增强静态分析；未配置时报告会显示“不可用”，不会伪装成已检测。
PRIVACY_FLOWDROID_ENABLED=false
PRIVACY_FLOWDROID_JAR_PATH=
PRIVACY_FLOWDROID_ANDROID_PLATFORMS=
PRIVACY_FLOWDROID_SOURCES_SINKS=
PRIVACY_NETWORK_THIRD_PARTY_DOMAINS=
PRIVACY_NETWORK_OVERSEAS_DOMAINS=
# 仅当 URL 命中下列白名单域名时，才判定为境外传输；逗号分隔。
PRIVACY_FRIDA_OVERSEAS_DOMAINS=

# --- 报告 ---
PRIVACY_PDF_CHANNEL=msedge
PRIVACY_REPORT_TEST_ORG=
PRIVACY_REPORT_SUBJECT_ORG=
PRIVACY_REPORT_ENTRUST_ORG=

# --- 规则引擎（证据链准入与三态判定口径） ---
# lenient（默认）：动态发现持有调用栈或时间关联台账之一即可准入；UI 发现持有一张
# 截图或一条时间线且满足规则语义即可准入；缺失项记录为提示不降级。
# strict：恢复完整跨源证据链门禁（调用栈+时间关联+一致性矩阵 / 截图+时间线齐备）。
PRIVACY_EVIDENCE_CHAIN_MODE=strict
# false（默认）：只有真正形成证据的场景才不算 not_covered。
# true：已尝试执行的自动场景记为 no_violation_evidence（会虚高覆盖率）。
PRIVACY_ATTEMPTED_SCENARIO_AS_COVERED=false

# --- 加密 ---
PRIVACY_FERNET_KEY_FILE=data/fernet.key
